generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("PRISMA_DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  EDITOR
  ORDER_MANAGER
  VIEWER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum PaymentMethod {
  COD
  VODAFONE_CASH
  INSTAPAY
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OfferType {
  FLASH_SALE
  BUY_X_GET_Y
  FREE_SHIPPING
  FIRST_ORDER
  SEASONAL
}

enum RelationType {
  RELATED
  COMPLEMENTARY
  UPSELL
  CROSS_SELL
  FREQUENTLY_BOUGHT
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  passwordHash      String
  role              Role                @default(VIEWER)
  name              String?
  active            Boolean             @default(true)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  logs              ActivityLog[]
  notifications     AdminNotification[]
}

model Customer {
  id                String                  @id @default(cuid())
  name              String
  phone             String                  @unique
  email             String?
  passwordHash      String?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  orders            Order[]
  addresses         Address[]
  reviews           Review[]
  wishlist          Wishlist[]
  notifications     CustomerNotification[]
  segments          CustomerSegmentMember[]

  @@index([createdAt])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String?
  governorate String
  city        String
  address     String
  notes       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([customerId, isDefault])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, sortOrder])
}

model Product {
  id               String                    @id @default(cuid())
  name             String
  slug             String                    @unique
  description      String?
  price            Decimal                   @db.Decimal(10, 2)
  comparePrice     Decimal?                  @db.Decimal(10, 2)
  stock            Int                       @default(0)
  sku              String                    @unique
  barcode          String?
  weight           Decimal?                  @db.Decimal(10, 3)
  material         String?
  careInstructions String?
  videoUrl         String?
  seoTitle         String?
  seoDescription   String?
  tags             String?
  featured         Boolean                   @default(false)
  newArrival       Boolean                   @default(false)
  bestSeller       Boolean                   @default(false)
  status           ProductStatus             @default(DRAFT)
  categoryId       String
  category         Category                  @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  reviews          Review[]
  orderItems       OrderItem[]
  wishlist         Wishlist[]
  relationsFrom    ProductRelation[]         @relation("RelationFrom")
  relationsTo      ProductRelation[]         @relation("RelationTo")
  backInStock      BackInStockSubscription[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([status, featured])
  @@index([status, newArrival])
  @@index([status, bestSeller])
  @@index([categoryId, status])
  @@index([stock, status])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id        String   @id @default(cuid())
  name      String
  value     String
  stock     Int      @default(0)
  price     Decimal? @db.Decimal(10, 2)
  sku       String?
  imageUrl  String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name, value])
  @@index([productId])
}

model BackInStockSubscription {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  email      String?
  phone      String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([productId, notifiedAt])
}

model GiftCard {
  id        String    @id @default(cuid())
  code      String    @unique
  amount    Decimal   @db.Decimal(10, 2)
  balance   Decimal   @db.Decimal(10, 2)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ProductRelation {
  id            String       @id @default(cuid())
  type          RelationType
  sortOrder     Int          @default(0)
  fromProductId String
  toProductId   String
  fromProduct   Product      @relation("RelationFrom", fields: [fromProductId], references: [id], onDelete: Cascade)
  toProduct     Product      @relation("RelationTo", fields: [toProductId], references: [id], onDelete: Cascade)

  @@unique([type, fromProductId, toProductId])
  @@index([fromProductId, type, sortOrder])
}

model Offer {
  id            String    @id @default(cuid())
  name          String
  type          OfferType
  discountValue Decimal?  @db.Decimal(10, 2)
  active        Boolean   @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([active, startsAt, endsAt])
}

model Coupon {
  id        String       @id @default(cuid())
  code      String       @unique
  type      DiscountType
  value     Decimal      @db.Decimal(10, 2)
  minOrder  Decimal?     @db.Decimal(10, 2)
  maxUses   Int?
  usedCount Int          @default(0)
  active    Boolean      @default(true)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([active, expiresAt])
}

model Order {
  id                    String          @id @default(cuid())
  number                String          @unique
  idempotencyKey        String?         @unique
  customerId            String?
  customer              Customer?       @relation(fields: [customerId], references: [id])
  status                OrderStatus     @default(NEW)
  paymentStatus         PaymentStatus   @default(PENDING)
  paymentMethod         PaymentMethod
  total                 Decimal         @db.Decimal(10, 2)
  shipping              Decimal         @db.Decimal(10, 2)
  discount              Decimal         @db.Decimal(10, 2)
  notes                 String?
  internalNotes         String?
  shippingGovernorate   String?
  shippingCity          String?
  shippingAddress       String?
  couponCode            String?
  customerNameSnapshot  String?
  customerPhoneSnapshot String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  stockReleasedAt       DateTime?
  items                 OrderItem[]
  payments              Payment[]
  timeline              OrderTimeline[]

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  variantId    String?
  variantName  String?
  variantValue String?
  skuSnapshot  String?
  name         String
  quantity     Int
  price        Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  reference   String?
  proofUrl    String?
  amount      Decimal       @db.Decimal(10, 2)
  confirmedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
  @@index([orderId])
}

model Wishlist {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([productId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  rating     Int
  text       String?
  imageUrl   String?
  verified   Boolean  @default(false)
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId, approved, createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ThemeSetting {
  id           String   @id @default(cuid())
  primaryColor String   @default("#171513")
  accentColor  String   @default("#C8A96B")
  background   String   @default("#F8F5EF")
  textColor    String   @default("#171513")
  logoUrl      String?
  faviconUrl   String?
  fontFamily   String?
  radiusScale  String?  @default("luxury")
  darkMode     Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  severity  String   @default("INFO")
  metadata  String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([severity, createdAt])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  name      String
  type      String
  alt       String?
  size      Int?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model HomepageSection {
  id        String    @id @default(cuid())
  type      String
  title     String?
  subtitle  String?
  imageUrl  String?
  ctaText   String?
  ctaUrl    String?
  visible   Boolean   @default(true)
  sortOrder Int       @default(0)
  status    String    @default("PUBLISHED")
  config    String?
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([visible, sortOrder])
}

model ShippingZone {
  id          String   @id @default(cuid())
  governorate String
  city        String?
  price       Decimal  @db.Decimal(10, 2)
  freeAbove   Decimal? @db.Decimal(10, 2)
  etaMinDays  Int?
  etaMaxDays  Int?
  active      Boolean  @default(true)

  @@unique([governorate, city])
  @@index([governorate, active])
}

model PaymentSetting {
  id            String        @id @default(cuid())
  method        PaymentMethod @unique
  enabled       Boolean       @default(true)
  label         String
  description   String?
  iconKey       String?
  accountName   String?
  accountNumber String?
  instructions  String?
  proofRequired Boolean       @default(false)
  displayOrder  Int           @default(0)
  updatedAt     DateTime      @updatedAt

  @@index([enabled, displayOrder])
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  source    String?
  createdAt DateTime @default(now())
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
}

model CustomerSegment {
  id          String                  @id @default(cuid())
  name        String                  @unique
  description String?
  rule        String
  active      Boolean                 @default(true)
  members     CustomerSegmentMember[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model CustomerSegmentMember {
  id         String          @id @default(cuid())
  segmentId  String
  segment    CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([segmentId, customerId])
}

model AdminNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String    @default("INFO")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model CustomerNotification {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String
  body       String
  type       String    @default("INFO")
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, readAt, createdAt])
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}
