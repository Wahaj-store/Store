// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // أو نوع القاعدة لديك (مثل sqlite أو mysql)
  url      = env("DATABASE_URL")
}

model Customer {
  id                 String                 @id @default(cuid())
  name               String?
  email              String                 @unique
  phone              String?                @unique
  password           String
  resetToken         String?                // مضاف حديثاً لتخزين رمز OTP
  resetTokenExpiry   DateTime?              // مضاف حديثاً لتخزين وقت انتهاء صلاحية الرمز
  notifications      CustomerNotification[]
  orders             Order[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model CustomerNotification {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String
  body       String
  type       String    @default("INFO")
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, readAt, createdAt])
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model FaqItem {
  id           String   @id @default(cuid())
  question     String
  answer       String
  category     String   @default("general") // general, shipping, payment, returns, products
  displayOrder Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, displayOrder])
}
