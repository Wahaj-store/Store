generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("PRISMA_DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  EDITOR
  ORDER_MANAGER
  VIEWER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum PaymentMethod {
  COD
  VODAFONE_CASH
  INSTAPAY
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OfferType {
  FLASH_SALE
  BUY_X_GET_Y
  FREE_SHIPPING
  FIRST_ORDER
  SEASONAL
}

enum GiftCardLedgerType {
  ISSUE
  REDEEM
  REFUND
  ADJUSTMENT
  EXPIRE
}

enum InventoryLedgerType {
  OPENING
  SALE
  RESTOCK
  ADJUSTMENT
  ORDER_RELEASE
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CANCELLED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  NOT_AS_DESCRIBED
  SIZE_ISSUE
  CHANGED_MIND
  OTHER
}

enum RelationType {
  RELATED
  COMPLEMENTARY
  UPSELL
  CROSS_SELL
  FREQUENTLY_BOUGHT
}

enum AbandonedCartStatus {
  ACTIVE
  ABANDONED
  RECOVERED
  CLEARED
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  passwordHash      String
  role              Role                @default(VIEWER)
  name              String?
  active            Boolean             @default(true)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  logs              ActivityLog[]
  notifications     AdminNotification[]
  inventoryLedger   InventoryLedger[]
}

model Customer {
  id                 String              @id @default(cuid())
  name               String?
  phone              String?             @unique // الرقم الأساسي للحساب (ثابت ولا يتغير بسهولة)
  secondaryPhone     String?             // رقم هاتف احتياطي يمكن للعميل إضافته وتعديله
  email              String?             @unique
  passwordHash       String?
  lastLoginAt        DateTime?
  resetToken         String?
  resetTokenExpiry   DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orders             Order[]
  wishlist           Wishlist[]
  notifications      CustomerNotification[]
  addresses          Address[]
  reviews            Review[]
  segmentMemberships CustomerSegmentMember[]
  issuedGiftCards   GiftCard[]             @relation("GiftCardIssuedTo")
  giftCardLedger    GiftCardLedger[]
  whatsappNotifications WhatsAppNotification[]
  abandonedCart       AbandonedCart?
  @@index([createdAt])
}

model Address {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label          String?  @default("المنزل")
  name           String?
  phone          String?
  secondaryPhone String?
  governorate    String
  city           String
  address        String
  notes          String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([customerId, isDefault])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  offers      Offer[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, sortOrder])
}

model Product {
  id               String                    @id @default(cuid())
  name             String
  slug             String                    @unique
  description      String?
  price            Decimal                   @db.Decimal(10, 2)
  comparePrice     Decimal?                  @db.Decimal(10, 2)
  stock            Int                       @default(0)
  sku              String                    @unique
  barcode          String?
  weight           Decimal?                  @db.Decimal(10, 3)
  material         String?
  careInstructions String?
  videoUrl         String?
  seoTitle         String?
  seoDescription   String?
  tags             String?
  searchText       String?
  featured         Boolean                   @default(false)
  newArrival       Boolean                   @default(false)
  bestSeller       Boolean                   @default(false)
  status           ProductStatus             @default(DRAFT)
  categoryId       String
  category         Category                  @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  offers            Offer[]
  bundleItems       BundleItem[]
  reviews          Review[]
  orderItems       OrderItem[]
  wishlist         Wishlist[]
  relationsFrom    ProductRelation[]         @relation("RelationFrom")
  relationsTo      ProductRelation[]         @relation("RelationTo")
  backInStock      BackInStockSubscription[]
  inventoryLedger  InventoryLedger[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([status, featured])
  @@index([status, newArrival])
  @@index([status, bestSeller])
  @@index([categoryId, status])
  @@index([stock, status])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id        String   @id @default(cuid())
  name      String
  value     String
  stock     Int      @default(0)
  price     Decimal? @db.Decimal(10, 2)
  sku       String?
  imageUrl  String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bundleItems BundleItem[]
  inventoryLedger InventoryLedger[]

  @@unique([productId, name, value])
  @@index([productId])
}

model BackInStockSubscription {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  email      String?
  phone      String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([productId, notifiedAt])
}

model GiftCard {
  id                String               @id @default(cuid())
  code              String               @unique
  codeHash          String?              @unique
  amount            Decimal              @db.Decimal(10, 2)
  balance           Decimal              @db.Decimal(10, 2)
  active            Boolean              @default(true)
  expiresAt         DateTime?
  issuedToCustomerId String?
  issuedToCustomer  Customer?            @relation("GiftCardIssuedTo", fields: [issuedToCustomerId], references: [id], onDelete: SetNull)
  orders            Order[]
  ledger            GiftCardLedger[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([active, expiresAt])
  @@index([issuedToCustomerId])
}

model GiftCardLedger {
  id            String             @id @default(cuid())
  giftCardId    String
  giftCard      GiftCard           @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  type          GiftCardLedgerType
  amount        Decimal            @db.Decimal(10, 2)
  balanceAfter Decimal            @db.Decimal(10, 2)
  orderId      String?
  order        Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reference     String?
  note          String?
  createdAt     DateTime           @default(now())

  @@index([giftCardId, createdAt])
  @@index([orderId])
  @@index([customerId, createdAt])
}

model ProductRelation {
  id            String       @id @default(cuid())
  type          RelationType
  sortOrder     Int          @default(0)
  fromProductId String
  toProductId   String
  fromProduct   Product      @relation("RelationFrom", fields: [fromProductId], references: [id], onDelete: Cascade)
  toProduct     Product      @relation("RelationTo", fields: [toProductId], references: [id], onDelete: Cascade)

  @@unique([type, fromProductId, toProductId])
  @@index([fromProductId, type, sortOrder])
}

model Bundle {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  price       Decimal      @db.Decimal(10, 2)
  imageUrl    String?
  active      Boolean      @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  items       BundleItem[]
  orderItems  OrderItem[]  @relation("OrderItemBundle")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([active, startsAt, endsAt])
}

model BundleItem {
  id        String         @id @default(cuid())
  bundleId  String
  bundle    Bundle         @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int            @default(1)

  @@unique([bundleId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

model Offer {
  id                   String       @id @default(cuid())
  name                 String
  type                 OfferType
  discountType         DiscountType @default(PERCENTAGE)
  discountValue        Decimal?     @db.Decimal(10, 2)
  minOrder             Decimal?     @db.Decimal(10, 2)
  maxDiscount          Decimal?     @db.Decimal(10, 2)
  priority             Int          @default(0)
  stackable            Boolean      @default(false)
  maxUses              Int?
  usedCount            Int          @default(0)
  productId            String?
  product              Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId           String?
  category             Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  buyQuantity          Int?
  getQuantity          Int?
  getDiscountPercent   Decimal?     @db.Decimal(5, 2)
  active               Boolean      @default(true)
  startsAt             DateTime?
  endsAt               DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([active, startsAt, endsAt])
  @@index([productId, active])
  @@index([categoryId, active])
}

model Coupon {
  id        String       @id @default(cuid())
  code      String       @unique
  type      DiscountType
  value     Decimal      @db.Decimal(10, 2)
  minOrder  Decimal?     @db.Decimal(10, 2)
  maxUses   Int?
  usedCount Int          @default(0)
  active    Boolean      @default(true)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([active, expiresAt])
}

model AbandonedCart {
  id             String              @id @default(cuid())
  customerId     String              @unique
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          Json
  subtotal       Decimal             @db.Decimal(10, 2)
  itemCount      Int
  cartHash       String
  status         AbandonedCartStatus @default(ACTIVE)
  lastSeenAt     DateTime            @default(now())
  reminderSentAt DateTime?
  recoveredAt    DateTime?
  orderId        String?             @unique
  order          Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, lastSeenAt])
  @@index([customerId, status])
  @@index([reminderSentAt])
}

model Order {
  id                    String          @id @default(cuid())
  number                String          @unique
  idempotencyKey        String?         @unique
  customerId            String?
  customer              Customer?       @relation(fields: [customerId], references: [id])
  status                OrderStatus     @default(NEW)
  paymentStatus         PaymentStatus   @default(PENDING)
  paymentMethod         PaymentMethod
  total                 Decimal         @db.Decimal(10, 2)
  shipping              Decimal         @db.Decimal(10, 2)
  discount              Decimal         @db.Decimal(10, 2)
  notes                 String?
  internalNotes         String?
  shippingGovernorate   String?
  shippingCity          String?
  shippingAddress       String?
  shippingProvider      String?      
  trackingNumber        String?    
  couponCode            String?
  customerNameSnapshot  String?
  customerPhoneSnapshot String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  stockReleasedAt       DateTime?
  giftCardId            String?
  giftCard              GiftCard?       @relation(fields: [giftCardId], references: [id], onDelete: SetNull)
  giftCardAmount        Decimal         @default(0) @db.Decimal(10, 2)
  items                 OrderItem[]
  payments              Payment[]
  timeline              OrderTimeline[]
  giftCardLedger        GiftCardLedger[]
  inventoryLedger       InventoryLedger[]
  shipments             Shipment[]
  returnRequests        ReturnRequest[]
  whatsappNotifications WhatsAppNotification[]
  abandonedCart         AbandonedCart?

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([customerId, createdAt])
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String?
  trackingNumber    String?
  status            ShipmentStatus @default(PENDING)
  shippedAt         DateTime?
  deliveredAt       DateTime?
  estimatedMinDays  Int?
  estimatedMaxDays  Int?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  events            ShipmentEvent[]

  @@index([orderId, createdAt])
  @@index([status, updatedAt])
  @@index([trackingNumber])
}

model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  note        String?
  createdAt   DateTime       @default(now())

  @@index([shipmentId, createdAt])
}

model ReturnRequest {
  id             String       @id @default(cuid())
  number         String       @unique
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         ReturnStatus @default(REQUESTED)
  reason         ReturnReason
  note           String?
  adminNote      String?
  requestedAt    DateTime     @default(now())
  approvedAt     DateTime?
  receivedAt     DateTime?
  refundedAt     DateTime?
  updatedAt      DateTime     @updatedAt
  items          ReturnItem[]

  @@index([orderId, requestedAt])
  @@index([status, requestedAt])
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity        Int
  restocked       Boolean       @default(false)
  restockedAt     DateTime?

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model InventoryLedger {
  id                    String              @id @default(cuid())
  productId             String?
  product               Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId             String?
  variant               ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  orderId               String?
  order                 Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId                String?
  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  type                  InventoryLedgerType
  quantity              Int
  balanceAfter          Int
  productNameSnapshot   String?
  variantNameSnapshot   String?
  variantValueSnapshot  String?
  skuSnapshot           String?
  reason                String?
  reference             String?
  createdAt             DateTime            @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([orderId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  bundleId     String?
  bundle       Bundle?  @relation("OrderItemBundle", fields: [bundleId], references: [id], onDelete: SetNull)
  returnItems  ReturnItem[]
  variantId    String?
  variantName  String?
  variantValue String?
  skuSnapshot  String?
  name         String
  quantity     Int
  price        Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@index([bundleId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  reference   String?
  proofUrl    String?
  amount      Decimal       @db.Decimal(10, 2)
  confirmedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
  @@index([orderId])
}

model Wishlist {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([productId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  rating     Int
  text       String?
  imageUrl   String?
  verified   Boolean  @default(false)
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId, approved, createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ThemeSetting {
  id           String   @id @default(cuid())
  primaryColor String   @default("#171513")
  accentColor  String   @default("#C8A96B")
  background   String   @default("#F8F5EF")
  textColor    String   @default("#171513")
  logoUrl      String?
  faviconUrl   String?
  fontFamily   String?
  radiusScale  String?  @default("luxury")
  darkMode     Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  severity  String   @default("INFO")
  metadata  String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([severity, createdAt])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  name      String
  type      String
  alt       String?
  size      Int?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model HomepageSection {
  id        String    @id @default(cuid())
  type      String
  title     String?
  subtitle  String?
  imageUrl  String?
  ctaText   String?
  ctaUrl    String?
  visible   Boolean   @default(true)
  sortOrder Int       @default(0)
  status    String    @default("PUBLISHED")
  config    String?
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([visible, sortOrder])
}

model ShippingZone {
  id          String   @id @default(cuid())
  governorate String
  city        String?
  price       Decimal  @db.Decimal(10, 2)
  freeAbove   Decimal? @db.Decimal(10, 2)
  etaMinDays  Int?
  etaMaxDays  Int?
  active      Boolean  @default(true)

  @@unique([governorate, city])
  @@index([governorate, active])
}

model PaymentSetting {
  id            String        @id @default(cuid())
  method        PaymentMethod @unique
  enabled       Boolean       @default(true)
  label         String
  description   String?
  iconKey       String?
  accountName   String?
  accountNumber String?
  instructions  String?
  proofRequired Boolean       @default(false)
  displayOrder  Int           @default(0)
  updatedAt     DateTime      @updatedAt

  @@index([enabled, displayOrder])
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  source    String?
  createdAt DateTime @default(now())
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
}

model CustomerSegment {
  id          String                  @id @default(cuid())
  name        String                  @unique
  description String?
  rule        String
  active      Boolean                 @default(true)
  members     CustomerSegmentMember[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model CustomerSegmentMember {
  id         String          @id @default(cuid())
  segmentId  String
  segment    CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([segmentId, customerId])
}

model AdminNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String    @default("INFO")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model CustomerNotification {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String
  body      String
  type      String    @default("INFO")
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, readAt, createdAt])
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model FaqItem {
  id           String   @id @default(cuid())
  question     String
  answer       String
  category     String   @default("general")
  displayOrder Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, displayOrder])
}


model WhatsAppNotification {
  id                String    @id @default(cuid())
  eventKey          String    @unique
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId           String?
  order             Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  phone             String
  template          String
  language          String    @default("ar")
  status            String    @default("PROCESSING")
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([customerId, createdAt])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
}
