# Database
PRISMA_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
PRISMA_DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Authentication — generate a unique secret of at least 32 characters
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@wahaj.store"
ADMIN_PASSWORD="change-this-immediately"

# Public site URL
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Vercel Blob (required for media and payment-proof uploads)
BLOB_READ_WRITE_TOKEN=""
BLOB_PUBLIC_READ_WRITE_TOKEN=""

# Distributed rate limiting (configure for production deployments)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
UPSTASH_REDIS_TIMEOUT_MS="2000"
RATE_LIMIT_SECRET="replace-with-a-unique-secret-of-at-least-32-characters"

# Scheduled jobs (required to authorize Vercel Cron requests)
CRON_SECRET="replace-with-a-unique-long-random-secret"

# Customer social sign-in (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Email notifications (optional)
BREVO_API_KEY=""
SENDER_EMAIL=""
SENDER_NAME="متجر وَهَج"

# WhatsApp Cloud API notifications (optional)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_VERSION="v23.0"
WHATSAPP_TEMPLATE_LANGUAGE="ar"
WHATSAPP_ORDER_CREATED_TEMPLATE=""
WHATSAPP_ORDER_STATUS_TEMPLATE=""
WHATSAPP_SHIPMENT_TEMPLATE=""
WHATSAPP_RETURN_TEMPLATE=""
